{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguaworld.local/schemas/living-town-npc.schema.json",
  "title": "Living Town NPC",
  "description": "Runtime-independent data contract for a single simulated town resident.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "age_group",
    "gender",
    "job",
    "archetype_id",
    "home_place_type",
    "workplace_place_type",
    "appearance",
    "personality",
    "needs",
    "mood",
    "schedule",
    "memory",
    "language_level",
    "speech_vocabulary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de"],
      "properties": {
        "de": { "type": "string", "minLength": 1 },
        "ar": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "age_group": { "enum": ["child", "teen", "young_adult", "adult", "older_adult", "senior"] },
    "gender": { "enum": ["female", "male", "nonbinary", "unspecified"] },
    "job": { "type": "string", "minLength": 1 },
    "archetype_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "home_place_type": { "type": "string", "minLength": 1 },
    "workplace_place_type": { "type": ["string", "null"] },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "model", "skin_color", "hair_color", "clothes_color", "accessories", "height_scale"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "model": { "enum": ["Barbarian", "Knight", "Mage", "Ranger", "Rogue"] },
        "skin_color": { "$ref": "#/$defs/hexColor" },
        "hair_color": { "$ref": "#/$defs/hexColor" },
        "clothes_color": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/hexColor" } },
        "accessories": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "height_scale": { "type": "number", "minimum": 0.85, "maximum": 1.15 }
      }
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendliness", "energy", "patience", "curiosity", "tidiness", "talkativeness"],
      "properties": {
        "friendliness": { "$ref": "#/$defs/trait" },
        "energy": { "$ref": "#/$defs/trait" },
        "patience": { "$ref": "#/$defs/trait" },
        "curiosity": { "$ref": "#/$defs/trait" },
        "tidiness": { "$ref": "#/$defs/trait" },
        "talkativeness": { "$ref": "#/$defs/trait" }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy", "hunger", "social", "fun", "money_need"],
      "properties": {
        "energy": { "$ref": "#/$defs/need" },
        "hunger": { "$ref": "#/$defs/need" },
        "social": { "$ref": "#/$defs/need" },
        "fun": { "$ref": "#/$defs/need" },
        "money_need": { "$ref": "#/$defs/need" }
      }
    },
    "mood": { "enum": ["happy", "neutral", "tired", "stressed", "angry", "excited"] },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "personal_variation"],
      "properties": {
        "template_id": { "type": "string" },
        "personal_variation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_offset_minutes", "duration_scale", "day_seed"],
          "properties": {
            "start_offset_minutes": { "type": "integer", "minimum": -40, "maximum": 40 },
            "duration_scale": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
            "day_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent_interactions", "player_relationship", "relationships"],
      "properties": {
        "recent_interactions": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/interaction" }
        },
        "player_relationship": { "type": "number", "minimum": -100, "maximum": 100 },
        "relationships": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "language_level": { "enum": ["A1", "A2"] },
    "speech_vocabulary": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "trait": { "type": "number", "minimum": 0, "maximum": 1 },
    "need": { "type": "number", "minimum": 0, "maximum": 100 },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "kind", "timestamp", "relationship_delta"],
      "properties": {
        "actor_id": { "type": "string" },
        "kind": { "enum": ["greeting", "conversation", "help", "trade", "shared_activity", "conflict"] },
        "timestamp": { "type": "integer", "minimum": 0 },
        "relationship_delta": { "type": "number", "minimum": -25, "maximum": 25 }
      }
    }
  }
}
