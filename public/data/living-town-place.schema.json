{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguaworld.local/schemas/living-town-place.schema.json",
  "title": "Living Town Smart Place Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units", "weekday_index", "places", "unavailable_place_types", "geometry_resolution"],
  "properties": {
    "schema_version": { "const": 1 },
    "units": { "const": "meters" },
    "weekday_index": { "type": "object", "minProperties": 7, "maxProperties": 7, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 6 } },
    "source_assets": { "type": "object" },
    "places": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/place" } },
    "unavailable_place_types": { "type": "array", "items": { "type": "object", "required": ["place_type", "reason"], "properties": { "place_type": { "type": "string" }, "reason": { "type": "string" } } } },
    "geometry_resolution": { "type": "object", "required": ["status", "reason", "anchor_nodes_can_be_resolved_at_runtime", "required_for_precise_slots"], "properties": { "status": { "type": "string" }, "reason": { "type": "string" }, "anchor_nodes_can_be_resolved_at_runtime": { "type": "boolean" }, "required_for_precise_slots": { "type": "array", "items": { "type": "string" } } } }
  },
  "$defs": {
    "position": { "type": "object", "required": ["x", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "step": { "type": "object", "required": ["state", "duration_minutes", "role", "animation"], "properties": { "state": { "type": "string" }, "duration_minutes": { "type": "number", "exclusiveMinimum": 0 }, "role": { "type": "string" }, "animation": { "type": "string" }, "speech_de": { "type": "string" }, "requires_slot": { "type": "string" }, "requires_slots": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "weather_sensitive": { "type": "boolean" }, "repeat": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } } }, "effects": { "type": "object" } } },
    "place": { "type": "object", "required": ["id", "place_type", "world_level", "status", "position", "opening_hours", "closed_days", "roles", "scripts"], "properties": { "id": { "type": "string" }, "place_type": { "type": "string" }, "world_level": { "type": "integer", "minimum": 1, "maximum": 5 }, "status": { "type": "string" }, "position": { "$ref": "#/$defs/position" }, "bounds": { "type": "object" }, "footprint": { "type": "object" }, "entrance": { "type": "object", "required": ["x", "z", "front"], "properties": { "x": { "type": "number" }, "z": { "type": "number" }, "front": { "type": "string" }, "source": { "type": "string" } } }, "opening_hours": { "type": "object", "required": ["open_minute", "close_minute"], "properties": { "open_minute": { "type": "integer", "minimum": 0, "maximum": 1439 }, "close_minute": { "type": "integer", "minimum": 1, "maximum": 1440 } } }, "closed_days": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } }, "roles": { "type": "object", "required": ["staff", "visitors"], "properties": { "staff": { "type": "array", "items": { "type": "string" } }, "visitors": { "type": "array", "items": { "type": "string" } } } }, "slots": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "role", "capacity"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "role": { "type": "string" }, "position": { "$ref": "#/$defs/position" }, "rotation_y": { "type": "number" }, "capacity": { "type": "integer", "minimum": 1 }, "source": { "type": "string" } } } }, "slot_templates": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "role", "anchor_node", "capacity_source", "resolution_status"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "role": { "type": "string" }, "anchor_node": { "type": "string" }, "queue_capacity": { "type": "integer", "minimum": 1 }, "capacity_source": { "type": "string" }, "resolution_status": { "type": "string" } } } }, "waypoints": { "type": "array", "items": { "type": "object", "required": ["id", "position", "kind"], "properties": { "id": { "type": "string" }, "position": { "$ref": "#/$defs/position" }, "kind": { "type": "string" }, "source": { "type": "string" } } } }, "scripts": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } } } }
  }
}
